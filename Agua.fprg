    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="V, A, L, H, ValorM" type="Integer" array="False" size=""/>
            <assign variable="ValorM" expression="50000"/>
            <input variable="A"/>
            <input variable="L"/>
            <input variable="H"/>
            <assign variable="V" expression="(A*L*H)"/>
            <input variable="ValorM"/>
            <assign variable="V" expression="(A*L*H)*ValorM"/>
            <output expression="V" newline="True"/>
