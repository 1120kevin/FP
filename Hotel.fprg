<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="hotel"/>
        <attribute name="authors" value="CAMILO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 07:27:24 p. m."/>
        <attribute name="created" value="Q0FNSUxPO0RFU0tUT1AtVTc4S0lDMTsyMDI2LTA0LTE1OzA2OjM4OjEwIHAuIG0uOzI5NTA="/>
        <attribute name="edited" value="Q0FNSUxPO0RFU0tUT1AtVTc4S0lDMTsyMDI2LTA0LTE1OzA3OjI3OjI0IHAuIG0uOzE7MzA2Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Total" type="Real" array="False" size=""/>
            <declare name="Aire, Ventilador, suite, Opcion" type="String" array="False" size=""/>
            <declare name="NA, NV, NS, TD, TotalComidas, Comidas" type="Integer" array="False" size=""/>
            <input variable="NA"/>
            <input variable="NV"/>
            <input variable="NS"/>
            <assign variable="TD" expression="NV+NA+NS"/>
            <input variable="Opcion"/>
            <if expression="TD=0">
                <then>
                    <output expression="&quot;Error&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="Total" expression="NA*90000+NV*70000+NS*100000"/>
                    <if expression="Opcion=&quot;S&quot;">
                        <then>
                            <assign variable="TotalComidas" expression="TD*30000"/>
                        </then>
                        <else/>
                    </if>
                    <if expression="TD&gt;=7">
                        <then>
                            <assign variable="Total" expression="(Total*0.85)+Comidas"/>
                        </then>
                        <else>
                            <assign variable="Total" expression="Total+TotalComidas"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
