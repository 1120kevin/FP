<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="kevin"/>
        <attribute name="authors" value="CAMILO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 05:53:32 p. m."/>
        <attribute name="created" value="Q0FNSUxPO0RFU0tUT1AtVTc4S0lDMTsyMDI2LTA0LTE1OzAzOjMwOjQ1IHAuIG0uOzI5NDc="/>
        <attribute name="edited" value="Q0FNSUxPO0RFU0tUT1AtVTc4S0lDMTsyMDI2LTA0LTE1OzA1OjUzOjMyIHAuIG0uOzE7MzA1OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Total, ND" type="Real" array="False" size=""/>
            <declare name="TipoH" type="String" array="False" size=""/>
            <declare name="Comida" type="Integer" array="False" size=""/>
            <declare name="DeseaComida" type="String" array="False" size=""/>
            <comment text="Digitar el TipoH &quot;Ventilado&quot;,&quot;Aire&quot;,&quot;Suite&quot;"/>
            <output expression="&quot;Fabor digitar TipoH Aire, Ventilador, Suite&quot;" newline="True"/>
            <input variable="TipoH"/>
            <input variable="ND"/>
            <if expression="TipoH=&quot;Ventilador&quot;">
                <then>
                    <assign variable="Total" expression="ND*70000"/>
                </then>
                <else>
                    <if expression="TipoH=&quot;Aire&quot;">
                        <then>
                            <assign variable="Total" expression="ND*90000"/>
                        </then>
                        <else>
                            <assign variable="Total" expression="ND*100000"/>
                        </else>
                    </if>
                </else>
            </if>
            <input variable="DeseaComida"/>
            <if expression="DeseaComida=&quot;si&quot;">
                <then>
                    <assign variable="Comida" expression="ND*30000"/>
                </then>
                <else>
                    <assign variable="Comida" expression="0"/>
                </else>
            </if>
            <assign variable="Total" expression="Total + Comida"/>
            <if expression="ND &gt;=7">
                <then>
                    <assign variable="Total" expression="Total*0.85"/>
                </then>
                <else>
                    <assign variable="Total" expression="100"/>
                </else>
            </if>
            <output expression="Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
